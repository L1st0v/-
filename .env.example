# Токен бота от BotFather
BOT_TOKEN=

# Ваш числовой Telegram ID (узнать можно у бота @userinfobot)
ADMIN_ID=

# Публичный HTTPS-адрес мини-приложения.
# Во время разработки сюда вставляется адрес туннеля,
# после покупки хостинга - адрес вашего домена.
# Пример: https://abc-def-ghi.trycloudflare.com
WEBAPP_URL=

# На каком порту работает сервер. Менять не обязательно.
HOST=0.0.0.0
PORT=8080

# Где хранить базу. Пусто - рядом с проектом.
# На хостинге сюда пишут путь на постоянном диске, например /data/event.db
DB_PATH=
